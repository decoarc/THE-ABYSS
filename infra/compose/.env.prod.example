# Copie para .env.prod (fora do git) e troque os segredos.
# SECRET_KEY_BASE: 64+ caracteres aleatórios, ex.: openssl rand -base64 48
POSTGRES_PASSWORD=troque-esta-senha
SECRET_KEY_BASE=troque-por-64-caracteres-aleatorios-troque-por-64-caracteres-aleatorios

# Host público do site (o WebSocket só aceita esta origem).
PHX_HOST=localhost
SITE_PORT=8080
# Link do e-mail de verificação (sem barra no fim).
ABYSS_WEB_URL=http://localhost:8080

# Medição: espécies de teste ligadas e semente fixa para repetir o mundo.
ABYSS_TEST_SPECIES=true
ABYSS_SEED=7

# Produção pública pela Cloudflare Tunnel (troque PHX_HOST/ABYSS_WEB_URL acima pelo domínio):
#   PHX_HOST=theabyss.example.com
#   ABYSS_WEB_URL=https://theabyss.example.com
#   ABYSS_WEB_ORIGINS=https://theabyss.example.com
#   SITE_PORT=127.0.0.1:8090        # o Caddy só no localhost; o público entra pelo túnel
# Token do túnel (Zero Trust → Networks → Tunnels); a rota pública aponta para http://caddy:80.
TUNNEL_TOKEN=

# E-mail de verificação pelo Resend (resend.com): domínio verificado e chave com "Sending access".
# Sem a chave, os e-mails ficam numa caixa em memória e ninguém os recebe.
RESEND_API_KEY=
#   ABYSS_MAIL_FROM=nao-responda@theabyss.example.com   # endereço no domínio verificado
