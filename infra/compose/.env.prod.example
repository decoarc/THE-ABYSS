# Copie para .env.prod (fora do git) e troque os segredos.
# SECRET_KEY_BASE: 64+ caracteres aleatórios, ex.: openssl rand -base64 48
POSTGRES_PASSWORD=troque-esta-senha
SECRET_KEY_BASE=troque-por-64-caracteres-aleatorios-troque-por-64-caracteres-aleatorios

# Host público do site (o WebSocket só aceita esta origem).
PHX_HOST=localhost
SITE_PORT=8080
# Link do e-mail de verificação (sem barra no fim).
ABYSS_WEB_URL=http://localhost:8080

# Medição: espécies de teste ligadas e semente fixa para repetir o mundo.
ABYSS_TEST_SPECIES=true
ABYSS_SEED=7
