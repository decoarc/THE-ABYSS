{
  "name": "the-abyss",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @abyss/web dev",
    "build": "pnpm --filter @abyss/web build",
    "preview": "pnpm --filter @abyss/web preview",
    "test": "pnpm --filter @abyss/web test",
    "typecheck": "pnpm --filter @abyss/web typecheck",
    "api:test": "docker compose -f infra/compose/compose.yaml run --rm api mix test",
    "api:up": "docker compose -f infra/compose/compose.yaml up -d db api",
    "api:down": "docker compose -f infra/compose/compose.yaml down",
    "e2e": "pnpm build && node scripts/e2e/run.mjs",
    "load": "node scripts/load/observers.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
