{
  "name": "the-abyss",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @abyss/web dev",
    "build": "pnpm --filter @abyss/web build",
    "preview": "pnpm --filter @abyss/web preview",
    "test": "pnpm --filter @abyss/web test",
    "typecheck": "pnpm --filter @abyss/web typecheck",
    "api:test": "docker compose -f infra/compose/compose.yaml run --rm api mix test",
    "api:up": "docker compose -f infra/compose/compose.yaml up -d db api backup",
    "api:reset": "docker compose -f infra/compose/compose.yaml run --rm api mix abyss.reset --yes && docker compose -f infra/compose/compose.yaml restart api",
    "api:down": "docker compose -f infra/compose/compose.yaml down",
    "api:backup:now": "docker compose -f infra/compose/compose.yaml run --rm backup --once",
    "api:restore": "sh scripts/backup/restore.sh",
    "e2e": "pnpm build && node scripts/e2e/run.mjs && node scripts/e2e/evolution.mjs && node scripts/e2e/persistence.mjs",
    "e2e:genesis": "pnpm build && node scripts/e2e/genesis.mjs",
    "load": "node scripts/load/observers.mjs",
    "vps:web": "pnpm --filter @abyss/web build --mode vps",
    "vps:up": "docker compose -f infra/compose/compose.prod.yaml --env-file infra/compose/.env.prod up -d --build",
    "vps:down": "docker compose -f infra/compose/compose.prod.yaml --env-file infra/compose/.env.prod down",
    "vps:medir": "node scripts/vps/medir.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
